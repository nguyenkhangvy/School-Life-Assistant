# The server's settings: copy to .env (cp .env.example .env) and fill them in. .env is never committed.

# The site's address, without https://: your DuckDNS name, or a domain of your own, pointing to the server's IP.
SITE_ADDRESS=sla-yourname.duckdns.org

# The database: Aiven's Service URI. If the password itself has an @, write that one as %40 (the @ before the
# server's name stays); if it has a $, put the whole value in single quotes.
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_SERVICE.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# The first Admin (README, "Accounts and roles"): register that account on the site, write its email here, then run
# update.sh. Once the site has an active Admin this does nothing; it can stay empty.
SITE_ADMIN_EMAIL=
